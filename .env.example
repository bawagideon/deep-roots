# =============================================================================
# DEEP ROOTS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your keys
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE (Database, RLS, Quotas, Knowledge Graph)
# Dashboard: https://supabase.com/dashboard/project/cjlsqvsxmzahzgwmumah
# Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://cjlsqvsxmzahzgwmumah.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (User Identity, Google Sign-in, User Button)
# Dashboard: https://dashboard.clerk.com
# API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# -----------------------------------------------------------------------------
# 3. AI PROVIDERS (Primary & Fallback Decomposition & Evidence)
# Google AI Studio: https://aistudio.google.com/app/apikey
# Anthropic Console: https://console.anthropic.com
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Optional Anthropic Claude fallback
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# 4. BILLING & PAYMENTS (Pro Subscriptions)
# Recommended for Nigeria/Global: Paystack (https://dashboard.paystack.com/#/settings/developer)
# Or Stripe: (https://dashboard.stripe.com/apikeys)
# -----------------------------------------------------------------------------
# Paystack (Leave blank if using Stripe or testing without payments)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Stripe (Optional alternative)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_YEARLY_PRICE_ID=price_your_yearly_price_id_here
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id_here

# -----------------------------------------------------------------------------
# 5. ADMIN & SECURITY CONFIGURATION
# Comma-separated Clerk User IDs granted admin access (e.g. user_2...,user_3...)
# -----------------------------------------------------------------------------
ADMIN_USER_IDS=

# Application Host URL (e.g. https://deeproots.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salt used to hash anonymous guest IPs before quota recording (keep secret)
IP_HASH_SALT=deep-roots-salt-change-in-production

# Quotas
NEXT_PUBLIC_DAILY_SCAN_LIMIT=5

# Environment Mode
NODE_ENV=development
